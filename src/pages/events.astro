---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { eventsList, siteImages } from '../data/consortium';

const categories = ['All', 'Roundtable', 'Trade Mission', 'Summit'];
---

<BaseLayout
  currentPath="/events"
  title="Events & Engagements | Canadian Bitcoin Consortium"
  description="2026–27 Events, Regulatory Roundtables, Trade Missions, and the Canadian Bitcoin Summit."
>
  <PageHeader
    eyebrow="Events & Engagements"
    title="2026–27 Events &amp; Engagements"
    subtitle="Convening banks, regulators, institutional capital, energy operators, and policymakers across Ottawa, Toronto, Calgary, and international missions."
  />

  <section class="bg-canvas py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center p-6 rounded-lg bg-surface border border-hairline">
        <div class="lg:col-span-5 rounded-md overflow-hidden aspect-video border border-hairline">
          <img
            src={siteImages.missionEvent1}
            alt="Canadian Bitcoin Consortium summit and regulatory roundtable"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="lg:col-span-7 space-y-4">
          <p class="text-xs font-mono text-cobalt font-medium">2026–27 Overview</p>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-cobalt">
            National Summits, Closed-Door Roundtables &amp; Trade Missions
          </h2>
          <p class="text-sm sm:text-base text-charcoal leading-relaxed">
            From OSFI Basel III and Bank of Canada RPAA roundtables to the 6th Annual Alberta Trade Mission and 3rd Annual Bitcoin on the Hill Day in Ottawa, Consortium convenings bridge technical execution and public policy.
          </p>
          <div class="inline-flex flex-wrap items-center gap-1 p-1 bg-canvas rounded-lg border border-hairline" role="group" aria-label="Filter events by format">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-event-filter={cat}
                class={`px-3.5 py-2 text-xs sm:text-sm font-semibold rounded-md whitespace-nowrap cursor-pointer transition-colors ${
                  idx === 0 ? 'bg-cobalt text-white' : 'text-charcoal hover:text-cobalt'
                }`}
              >
                {cat === 'All' ? 'All Formats' : cat + 's'}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Events List -->
      <div id="events-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {eventsList.map((ev) => (
          <article
            id={ev.id}
            data-category={ev.category}
            class="rounded-lg bg-surface border border-hairline overflow-hidden flex flex-col justify-between"
          >
            <div>
              <div class="h-48 overflow-hidden border-b border-hairline">
                <img src={ev.image} alt={ev.title} class="w-full h-full object-cover" />
              </div>
              <div class="p-6 sm:p-8 space-y-3">
                <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-charcoal tabular-nums">
                  <span>{ev.dateLabel}</span>
                  <span aria-hidden="true">·</span>
                  <span>{ev.location}</span>
                  <span aria-hidden="true">·</span>
                  <span class="text-cobalt font-semibold">{ev.status}</span>
                </div>
                <h3 class="font-display text-2xl font-bold text-cobalt">{ev.title}</h3>
                <p class="text-sm text-charcoal leading-relaxed">{ev.summary}</p>
                <ul class="pt-2 space-y-1.5 text-sm text-ink list-disc pl-5">
                  {ev.focusPoints.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="px-6 sm:px-8 pb-6 pt-4 border-t border-hairline flex items-center justify-between gap-4">
              <span class="text-xs font-mono text-charcoal">{ev.category}</span>
              <button
                type="button"
                data-rsvp-event={ev.title}
                class="inline-flex items-center justify-center min-h-10 px-4 py-2 rounded-md bg-cobalt hover:bg-cobalt-dark text-white text-xs sm:text-sm font-semibold whitespace-nowrap cursor-pointer transition-colors"
              >
                Request Invitation / Info
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Event Inquiry / RSVP Modal -->
  <div
    id="event-rsvp-modal"
    class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="rsvp-modal-title"
  >
    <div class="bg-surface border border-hairline rounded-lg max-w-lg w-full p-6 sm:p-8 space-y-5 shadow-xl">
      <div class="flex items-start justify-between gap-4 border-b border-hairline pb-4">
        <div>
          <p class="text-xs font-mono text-cobalt font-medium">Event Registration &amp; Delegation</p>
          <h3 id="rsvp-modal-title" class="font-display text-2xl font-bold text-cobalt mt-1"></h3>
        </div>
        <button
          id="close-rsvp-modal"
          type="button"
          aria-label="Close registration modal"
          class="w-10 h-10 rounded-md border border-hairline flex items-center justify-center text-ink hover:bg-canvas cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="rsvp-form" class="space-y-4" novalidate>
        <div>
          <label for="rsvp-name" class="block text-xs font-semibold text-ink mb-1">Full Name</label>
          <input id="rsvp-name" type="text" required class="w-full min-h-11 px-3.5 py-2 rounded-md border border-hairline bg-canvas text-sm text-ink focus:outline-none focus:border-cobalt" />
        </div>
        <div>
          <label for="rsvp-org" class="block text-xs font-semibold text-ink mb-1">Organization / Institution</label>
          <input id="rsvp-org" type="text" required class="w-full min-h-11 px-3.5 py-2 rounded-md border border-hairline bg-canvas text-sm text-ink focus:outline-none focus:border-cobalt" />
        </div>
        <div>
          <label for="rsvp-email" class="block text-xs font-semibold text-ink mb-1">Work Email</label>
          <input id="rsvp-email" type="email" required class="w-full min-h-11 px-3.5 py-2 rounded-md border border-hairline bg-canvas text-sm text-ink focus:outline-none focus:border-cobalt" />
        </div>
        <p id="rsvp-error" class="hidden text-xs text-red-700" role="alert"></p>
        <div id="rsvp-success" class="hidden p-4 rounded-md bg-canvas border border-cobalt/30 text-sm text-ink" role="status">
          Thank you. Your interest has been recorded—our events team will follow up with agenda details and credentials.
        </div>
        <button
          type="submit"
          class="w-full min-h-11 px-5 py-2.5 rounded-md bg-cobalt hover:bg-cobalt-dark text-white text-sm font-semibold cursor-pointer transition-colors"
        >
          Submit Request
        </button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('[data-event-filter]');
  const eventCards = document.querySelectorAll('#events-grid article');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-event-filter');
      filterBtns.forEach((b) => {
        const active = b.getAttribute('data-event-filter') === cat;
        if (active) {
          b.classList.add('bg-cobalt', 'text-white');
          b.classList.remove('text-charcoal');
        } else {
          b.classList.remove('bg-cobalt', 'text-white');
          b.classList.add('text-charcoal');
        }
      });

      eventCards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        card.classList.toggle('hidden', cat !== 'All' && cardCat !== cat);
      });
    });
  });

  const rsvpModal = document.getElementById('event-rsvp-modal');
  const rsvpTitle = document.getElementById('rsvp-modal-title');
  const closeRsvpBtn = document.getElementById('close-rsvp-modal');
  const rsvpForm = document.getElementById('rsvp-form') as HTMLFormElement | null;
  const rsvpError = document.getElementById('rsvp-error');
  const rsvpSuccess = document.getElementById('rsvp-success');

  document.querySelectorAll('[data-rsvp-event]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-rsvp-event') || 'Consortium Event';
      if (rsvpTitle) rsvpTitle.textContent = title;
      rsvpError?.classList.add('hidden');
      rsvpSuccess?.classList.add('hidden');
      rsvpForm?.reset();
      rsvpModal?.classList.remove('hidden');
    });
  });

  closeRsvpBtn?.addEventListener('click', () => rsvpModal?.classList.add('hidden'));
  rsvpModal?.addEventListener('click', (e) => {
    if (e.target === rsvpModal) rsvpModal.classList.add('hidden');
  });

  rsvpForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('rsvp-name') as HTMLInputElement).value.trim();
    const org = (document.getElementById('rsvp-org') as HTMLInputElement).value.trim();
    const email = (document.getElementById('rsvp-email') as HTMLInputElement).value.trim();
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    if (!name || !org || !emailOk) {
      if (rsvpError) {
        rsvpError.textContent = 'Please complete your name, organization, and a valid email address.';
        rsvpError.classList.remove('hidden');
      }
      rsvpSuccess?.classList.add('hidden');
      return;
    }

    rsvpError?.classList.add('hidden');
    rsvpSuccess?.classList.remove('hidden');
  });
</script>
