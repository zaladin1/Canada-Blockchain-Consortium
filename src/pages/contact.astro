---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  currentPath="/contact"
  title="Contact | Canadian Bitcoin Consortium"
  description="Help shape the future of Bitcoin in Canada. Reach the Canadian Bitcoin Consortium policy and membership desk."
>
  <PageHeader
    eyebrow="Contact"
    title="Help shape the future of Bitcoin in Canada."
    subtitle="Join us to build connections, share ideas, and grow alongside a community committed to advancing Bitcoin in Canada."
  />

  <section class="bg-canvas py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5 space-y-6">
        <div class="p-6 sm:p-8 rounded-lg bg-surface border border-hairline space-y-5">
          <div class="space-y-1">
            <p class="text-xs font-mono text-cobalt font-medium">Direct Inquiries</p>
            <h2 class="font-display text-2xl font-normal text-cobalt">Consortium Office</h2>
          </div>

          <div class="space-y-4 text-sm text-charcoal">
            <div>
              <p class="font-semibold text-ink">General &amp; Policy Desk</p>
              <a href="mailto:info@mybtccanada.ca" class="text-cobalt font-semibold hover:underline">info@mybtccanada.ca</a>
            </div>
            <div>
              <p class="font-semibold text-ink">Regional Presence</p>
              <p>Ottawa (Federal Advocacy) · Calgary (Energy &amp; Trade Missions) · Toronto (Financial Markets)</p>
            </div>
            <div>
              <p class="font-semibold text-ink">Media &amp; Parliamentary Briefings</p>
              <p>Requests for Standing Committee briefs, research white papers, or roundtable participation are answered within one business day.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form id="contact-form" class="p-6 sm:p-8 rounded-lg bg-surface border border-hairline space-y-5" novalidate>
          <h2 class="font-display text-2xl font-normal text-cobalt">Send a Message</h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="c-name" class="block text-xs font-semibold text-ink mb-1.5">Full Name</label>
              <input id="c-name" type="text" required class="w-full min-h-11 px-3.5 py-2 rounded-md border border-hairline bg-canvas text-sm text-ink focus:outline-none focus:border-cobalt" />
            </div>
            <div>
              <label for="c-email" class="block text-xs font-semibold text-ink mb-1.5">Email Address</label>
              <input id="c-email" type="email" required class="w-full min-h-11 px-3.5 py-2 rounded-md border border-hairline bg-canvas text-sm text-ink focus:outline-none focus:border-cobalt" />
            </div>
          </div>

          <div>
            <label for="c-topic" class="block text-xs font-semibold text-ink mb-1.5">Subject / Topic</label>
            <input id="c-topic" type="text" required class="w-full min-h-11 px-3.5 py-2 rounded-md border border-hairline bg-canvas text-sm text-ink focus:outline-none focus:border-cobalt" placeholder="e.g., Policy Research Inquiry, Event Sponsorship, Media" />
          </div>

          <div>
            <label for="c-message" class="block text-xs font-semibold text-ink mb-1.5">Message</label>
            <textarea id="c-message" rows="5" required class="w-full px-3.5 py-2.5 rounded-md border border-hairline bg-canvas text-sm text-ink focus:outline-none focus:border-cobalt"></textarea>
          </div>

          <p id="c-error" class="hidden text-xs text-red-700" role="alert"></p>
          <div id="c-success" class="hidden p-4 rounded-md bg-canvas border border-cobalt/30 text-sm text-ink" role="status">
            Thank you for reaching out to the Canadian Bitcoin Consortium. Your message has been received and routed to our team.
          </div>

          <button
            type="submit"
            class="inline-flex items-center justify-center min-h-11 px-6 py-3 rounded-md bg-cobalt hover:bg-cobalt-dark text-white text-sm font-semibold cursor-pointer transition-colors"
          >
            Send Inquiry
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const topicParam = params.get('topic');
  const topicInput = document.getElementById('c-topic') as HTMLInputElement | null;
  if (topicParam && topicInput) {
    topicInput.value = `Briefing Request: ${topicParam}`;
  }

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errEl = document.getElementById('c-error');
  const okEl = document.getElementById('c-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('c-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('c-email') as HTMLInputElement).value.trim();
    const topic = (document.getElementById('c-topic') as HTMLInputElement).value.trim();
    const msg = (document.getElementById('c-message') as HTMLTextAreaElement).value.trim();
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    if (!name || !emailOk || !topic || !msg) {
      if (errEl) {
        errEl.textContent = 'Please fill out all required fields with a valid email address.';
        errEl.classList.remove('hidden');
      }
      okEl?.classList.add('hidden');
      return;
    }

    errEl?.classList.add('hidden');
    okEl?.classList.remove('hidden');
    form.reset();
  });
</script>
