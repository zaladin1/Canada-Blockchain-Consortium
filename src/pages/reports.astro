---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { annualReports, siteImages } from '../data/consortium';
---

<BaseLayout
  currentPath="/reports"
  title="Reports | Canadian Bitcoin Consortium"
  description="Tracking Progress. Driving Transparency. Bi-annual and annual reports documenting Consortium advocacy, research, and ecosystem impact."
>
  <PageHeader
    eyebrow="Reports"
    title="Tracking Progress. Driving Transparency."
    subtitle="The Canadian Bitcoin Consortium’s bi-annual and annual reports document our measurable impact across policy advocacy, regulatory engagement, research, and national convenings."
  />

  <section class="bg-canvas py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center p-6 sm:p-8 rounded-lg bg-surface border border-hairline">
        <div class="lg:col-span-5 rounded-md overflow-hidden border border-hairline aspect-[4/3] bg-canvas">
          <img
            src={siteImages.report2025}
            alt="2025 Year End Report — Canadian Bitcoin Consortium"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="lg:col-span-7 space-y-4">
          <p class="text-xs font-mono text-cobalt font-medium">Accountability Commitment</p>
          <h2 class="font-display text-2xl sm:text-3xl font-normal text-cobalt">
            Documenting Measurable Advocacy Outcomes
          </h2>
          <p class="text-sm sm:text-base text-charcoal leading-relaxed">
            By publishing regular progress editions, we keep members, institutional partners, and public-sector stakeholders informed of parliamentary meetings, trade mission delegations, and policy milestones achieved nationwide.
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="/policies-research"
              class="inline-flex items-center justify-center min-h-11 px-5 py-2.5 rounded-md bg-cobalt hover:bg-cobalt-dark text-white text-sm font-semibold transition-colors"
            >
              Browse White Papers
            </a>
            <a
              href="/industry-responses"
              class="inline-flex items-center justify-center min-h-11 px-5 py-2.5 rounded-md border border-cobalt text-cobalt hover:bg-cobalt hover:text-white text-sm font-semibold transition-colors"
            >
              View Industry Responses
            </a>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        {annualReports.map((rep) => (
          <article class="p-6 sm:p-8 rounded-lg bg-surface border border-hairline grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-3 rounded-md overflow-hidden border border-hairline aspect-[4/3]">
              <img src={rep.image} alt={rep.title} class="w-full h-full object-cover" />
            </div>
            <div class="lg:col-span-5 space-y-3">
              <div class="flex items-center gap-2 text-xs font-mono text-charcoal tabular-nums">
                <span>{rep.year}</span>
                <span aria-hidden="true">·</span>
                <span>{rep.period}</span>
              </div>
              <h3 class="font-display text-2xl sm:text-3xl font-normal text-cobalt">{rep.title}</h3>
              <p class="text-sm text-charcoal leading-relaxed">{rep.summary}</p>
            </div>
            <div class="lg:col-span-4 grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-3 border-t lg:border-t-0 lg:border-l border-hairline pt-6 lg:pt-0 lg:pl-8">
              {rep.metrics.map((m) => (
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-xs text-charcoal">{m.label}</span>
                  <span class="font-mono text-sm font-semibold text-cobalt tabular-nums">{m.value}</span>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
