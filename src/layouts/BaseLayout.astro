---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'Canadian Bitcoin Consortium | An Advocacy Group dedicated to sound monetary and energy policy',
  description = 'Advocating for sound monetary policy, industry growth, and regulatory engagement in Canada’s digital asset ecosystem.',
  currentPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&family=Oswald:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface text-ink min-h-screen flex flex-col selection:bg-cobalt selection:text-white">
    <a
      href="#page"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-cobalt focus:text-white focus:text-sm focus:rounded-md"
    >
      Skip to Content
    </a>

    <Header currentPath={currentPath} />

    <main id="page" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
